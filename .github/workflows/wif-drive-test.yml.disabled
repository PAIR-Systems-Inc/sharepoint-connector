# Manual verification that Google Drive works via Workload Identity Federation —
# the keyless auth path for a workload running OFF Google Cloud (auth option 3 in
# docs/usage.md).
#
# GitHub Actions is a genuine off-GCP workload that issues an OIDC token, so this
# is a real end-to-end exercise of that path: the job presents its OIDC token, GCP
# exchanges it for short-lived service-account credentials, and the connector's
# normal ADC code path reads the Shared Drive. NO service-account key and NO
# repository secret are involved — that is the whole point.
#
# Manual trigger only (workflow_dispatch): it touches a real Drive, so it must not
# run on every push.
#
# DISABLED (.disabled so GitHub ignores it) and the GCP side has been torn down
# after verification, so re-running needs the pool re-created first:
#
#   PROJECT_NUM=<your project number>
#   REPO=OWNER/REPO
#   SA=goodmem-connector@<project>.iam.gserviceaccount.com
#
#   gcloud iam workload-identity-pools create github-pool --location=global
#   gcloud iam workload-identity-pools providers create-oidc github-provider \
#     --location=global --workload-identity-pool=github-pool \
#     --issuer-uri="https://token.actions.githubusercontent.com" \
#     --attribute-mapping="google.subject=assertion.sub,attribute.repository=assertion.repository" \
#     --attribute-condition="assertion.repository=='$REPO'"
#   gcloud iam service-accounts add-iam-policy-binding "$SA" \
#     --role=roles/iam.workloadIdentityUser \
#     --member="principalSet://iam.googleapis.com/projects/$PROJECT_NUM/locations/global/workloadIdentityPools/github-pool/attribute.repository/$REPO"
#
# Then update workload_identity_provider / service_account below and rename to .yml.
#
# Dispatching gotcha: GitHub only offers workflow_dispatch for files that exist on
# the DEFAULT branch. On a feature branch the run button/API returns 404 — either
# merge it to the default branch first, or temporarily add a push trigger scoped to
# a throwaway branch.
# NOTE: this repo is public, so job logs are world-readable — the live test
# deliberately logs MIME types and sizes rather than document names.
name: WIF Google Drive check (manual)

on:
  workflow_dispatch:
    inputs:
      drive_id:
        description: "Shared Drive ID to list (read-only)"
        required: true
        default: "0AFuVPqpbmZ2oUk9PVA"

permissions:
  contents: read
  id-token: write # required: lets the job request an OIDC token for the exchange

jobs:
  drive-check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Authenticate to Google Cloud (keyless, via WIF)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: projects/356072348069/locations/global/workloadIdentityPools/github-pool/providers/github-provider
          service_account: goodmem-connector@forrest-sandbox-472500.iam.gserviceaccount.com
          # Drive is not covered by the default cloud-platform scope.
          token_format: access_token
          access_token_scopes: https://www.googleapis.com/auth/drive.readonly

      - uses: actions/setup-go@v5
        with:
          go-version: "1.23"

      - name: Show which identity we ended up as
        run: |
          echo "credentials file: ${GOOGLE_APPLICATION_CREDENTIALS:-<unset>}"
          if [ -n "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
            python3 -c "import json,sys;d=json.load(open('$GOOGLE_APPLICATION_CREDENTIALS'));print('  credential type:',d.get('type'))"
          fi

      - name: Read the Shared Drive through the connector's ADC path
        env:
          GDRIVE_LIVE: "1"
          GOOGLE_DRIVE_ID: ${{ inputs.drive_id || '0AFuVPqpbmZ2oUk9PVA' }}
          GONOSUMDB: "fury.io/*"
          GOTOOLCHAIN: local
        run: |
          test -n "$GOOGLE_DRIVE_ID" || { echo "GOOGLE_DRIVE_ID is empty - the test would skip"; exit 1; }
          go test ./internal/providers/googledrive -run TestLive -v | tee /tmp/out
          grep -q -- "--- PASS: TestLive_ListGoogleDrive" /tmp/out || { echo "live test did not run (skipped?)"; exit 1; }
